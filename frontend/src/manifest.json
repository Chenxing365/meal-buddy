{
  "name": "meal-buddy",
  "appid": "",
  "description": "恰饭啦 Meal-Buddy AI智能外卖餐饮与自提消费平台",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "vueVersion": "3",
  "h5": {
    "title": "恰饭啦 Meal-Buddy",
    "router": {
      "mode": "hash",
      "base": "./"
    },
    "devServer": {
      "port": 5173,
      "proxy": {
        "/api": {
          "target": "http://127.0.0.1:8080",
          "changeOrigin": true
        },
        "/ws": {
          "target": "http://127.0.0.1:8080",
          "changeOrigin": true,
          "ws": true
        }
      }
    }
  },
  "mp-weixin": {
    "appid": "wx-mealbuddy-dev",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "你的位置信息将用于推荐附近的美食门店"
      }
    }
  }
}

